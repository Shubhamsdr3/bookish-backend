const express = require('express');
const router = express.Router();
const userInfo = require('../data/userinfo');

const firestoreDB = require('../init');
const userCollection = firestoreDB.collection("users")

// get user profile.
router.get('/user', async function(req, resp) {
    const userId = req.query.userId;
    console.log("Getting info for user: " + userId);
    resp.setHeader("Content-Type", "application/json")
    resp.setHeader("Charset", "utf-8")
    const userDocRef = userCollection.doc(userId).get()
    userDocRef.then(snapshot => {
        console.log(snapshot.data())
        resp.status(200).json({"isSuccess": true, "data": snapshot.data()});
    }).catch(error => {
        console.log(error);
        resp.status(200).json({"isSuccess": false, "message": "Error getting user"});
    })
})

router.put('/user/profile/update', async function(req, resp) {
    const userDetails = req.body;

    console.log("The request body: " + JSON.stringify(userDetails));
    const userId = userDetails['userId'];
    console.log("Updating user....userId: " + userId);
    resp.setHeader("Content-Type", "application/json")
    resp.setHeader("Charset", "utf-8")
    if(!userId) {
        resp.status(200).json({"isSuccess": false, "message": "No user exist"})
    } else {
        await userCollection.doc(userId).set({
            'userName': userDetails.userName,
            'name': userDetails.name,
            'profileIcon': userDetails.profileIcon,
            'connections': userDetails.connections,
            'createdAt': userDetails.createdAt,
            'privacy': userDetails.privacy,
            'phoneNumber': userDetails.phoneNumber
            }, {merge: true});
        const userDocRef = userCollection.doc(userId).get()
        userDocRef.then(snapshot => {
            console.log(snapshot.data())
            resp.status(200).json({"isSuccess": true, "data": snapshot.data()});
        }).catch(error => {
            console.log(error);
            resp.status(200).json({"isSuccess": false, "message": "Error in updating user"});
        })
    }
})

module.exports = router