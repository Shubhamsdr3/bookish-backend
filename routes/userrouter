const express = require('express');
const router = express.Router();
const userInfo = require('../data/userinfo');

const firestoreDB = require('../init');
const { READER_COLLECTION, FEEDBACK_COLLECTION } = require('../utils/constants');

const userCollection = firestoreDB.collection(READER_COLLECTION)
const feedbackCollection = firestoreDB.collection(FEEDBACK_COLLECTION)

// get user profile.
router.get('/reader', async function(req, resp) {
    const userId = req.query.userId;
    console.log("Getting info for user: " + userId);
    resp.setHeader("Content-Type", "application/json")
    resp.setHeader("Charset", "utf-8")
    if(!userId) {
        console.log("User id not valid: " + userId);
        resp.status(200).json({"isSuccess": false, "data": userInfo});
    } else {
        const userDocRef = userCollection.doc(userId).get()
        userDocRef.then(snapshot => {
            console.log(snapshot.data())
            resp.status(200).json({"isSuccess": true, "data": snapshot.data()});
        }).catch(error => {
            console.log(error);
            resp.status(200).json({"isSuccess": false, "message": "Error getting user"});
        })
    }
})

router.put('/reader/profile/update', async function(req, resp) {
    console.log("Updating the user profile...");
    const userDetails = req.body;
    console.log("The request body: " + JSON.stringify(userDetails));
    const userId = userDetails['userId'];
    console.log("Updating user....userId: " + userId);
    resp.setHeader("Content-Type", "application/json")
    resp.setHeader("Charset", "utf-8")
    if(!userId) {
        resp.status(200).json({"isSuccess": false, "message": "No user exist"})
    } else {
        await userCollection.doc(userId).set({
            'userName': userDetails.userName,
            'name': userDetails.name,
            'profileIcon': userDetails.profileIcon,
            'connections': userDetails.connections,
            'createdAt': userDetails.createdAt,
            'privacy': userDetails.privacy,
            'phoneNumber': userDetails.phoneNumber,
            'readingStatus': userDetails.userStatus,
            'userId': userDetails.userId
            }, {merge: true});
        const userDocRef = userCollection.doc(userId).get()
        userDocRef.then(snapshot => {
            console.log(snapshot.data())
            resp.status(200).json({"isSuccess": true, "data": snapshot.data()});
        }).catch(error => {
            console.log(error);
            resp.status(200).json({"isSuccess": false, "message": "Error in updating user"});
        })
    }
})

router.post('/reader/feedback', async function(req, res) {
    try {
        const feedback = req.body;
        console.log("User feedback: " + feedback['subject']);
        res.setHeader("Content-Type", "application/json")
        res.setHeader("Charset", "utf-8")
        const documentRef = feedbackCollection.doc();
        await documentRef.set(feedback);
        feedbackCollection.doc(documentRef.id).get().then(snapshot => {
            console.log(snapshot.data());
            res.status(200).json({"isSuccess": true, "data": snapshot.data()});
        }).catch(error => {
            console.log(error);
            res.status(200).json({"isSuccess": false, "message": error.message});
        })
    } catch(err) {
        console.log(err);
        res.status(200).json({"isSuccess": false, "message": "Error in adding in feedback."});
    }
});

module.exports = router